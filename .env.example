# Neon Postgres, pooled or direct — the HTTP driver does not use a pool either way.
DATABASE_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Credentials for /analytics/private, as user:password. Basic Auth is checked in
# middleware, so this is read at the edge, not by the SvelteKit function.
ANALYTICS_PRIVATE_AUTH="mikhail:choose-something-long"

# Set the same value in the Vercel project settings; Vercel sends it as
# `Authorization: Bearer $CRON_SECRET` on scheduled invocations of /api/cron/sweep.
CRON_SECRET="choose-something-long"
