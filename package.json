{
	"name": "mikhail-portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"lint": "oxlint src middleware.ts drizzle.config.ts",
		"format": "oxfmt src middleware.ts drizzle.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "7.0.3",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.6",
		"drizzle-kit": "0.31.11",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	},
	"dependencies": {
		"@neondatabase/serverless": "1.2.1",
		"@vercel/functions": "3.11.3",
		"drizzle-orm": "0.45.4",
		"isbot": "5.2.3"
	}
}
