{
	"name": "mikhail-portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"lint": "oxlint src middleware.ts drizzle.config.ts",
		"format": "oxfmt src middleware.ts drizzle.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@types/node": "26.1.2",
		"drizzle-kit": "0.31.10",
		"oxfmt": "0.61.0",
		"oxlint": "1.76.0",
		"svelte": "5.56.8",
		"svelte-check": "4.7.4",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@neondatabase/serverless": "1.1.0",
		"@vercel/functions": "3.8.0",
		"drizzle-orm": "0.45.2",
		"isbot": "5.2.1"
	}
}
